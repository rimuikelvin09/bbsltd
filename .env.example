# ---------------------------------------------------------------------------
# Website leads -> Microsoft 365
# Set these in Vercel: Project Settings -> Environment Variables.
# Never commit real values; .env*.local is already gitignored.
# ---------------------------------------------------------------------------

# Entra ID app registration (Overview page)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The SharePoint site and list that hold the leads.
# Get both from Graph Explorer -- see docs/leads-setup.md
MS_SITE_ID=
MS_LIST_ID=

# The mailbox notifications and acknowledgements are sent FROM.
MS_SENDER_UPN=info@bbsltd.ke

# The Sales Dpt channel's email address (Teams -> channel -> ... -> Get email
# address). Mail sent here appears as a post in the channel.
MS_SALES_CHANNEL_EMAIL=

# Existing site settings
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_YOUTUBE_API_KEY=
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=
